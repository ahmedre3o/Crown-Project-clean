# Crown frontend – API base URL (baked at build time)
# Production: Crown API on Cloud Run. Local dev can use http://localhost:5001 or leave unset to use code fallback.
NEXT_PUBLIC_API_URL=https://crown-api-756273570281.us-central1.run.app

# --- Backend (local backend/.env or Cloud Run env) — Smart assistant /api/chat ---
# Cloud Run: map GEMINI_API_KEY → Secret Manager secret (e.g. vertex-gemini-api-key:latest) — same “API key” from Vertex/Gemini console.
# GOOGLE_CLOUD_PROJECT is set automatically on Cloud Run; locally optional (defaults to gen-lang-client-0711622878).
#
# Default: Vertex AI Gemini in us-central1 (`GEMINI_USE_VERTEXAI=true` by default).
# GEMINI_USE_VERTEXAI=false — optional; use Gemini Developer API (generativelanguage.googleapis.com).
# VERTEX_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-flash
# Optional fallbacks for the key: GOOGLE_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY
# Optional: GEMINI_API_VERSION=v1
# Optional: GEMINI_REQUEST_DELAY_MS=500
# Optional: GEMINI_RETRY_MAX=4
# Optional: GEMINI_HTTP_USER_AGENT=...
# Optional AI chat resilience:
# AI_CHAT_QUEUE_CONCURRENCY=3
# AI_CHAT_CACHE_TTL_MS=600000
# OCR queue/retry tuning (invoice image import):
# OCR_QUEUE_CONCURRENCY=3
# OCR_MAX_RETRIES=5            # retries on 429/transient: 1s,2s,4s,8s (+ capped extra retry)
# OCR_TIMEOUT_MS=45000
# OCR_SLOW_MS=2000
# OCR_CACHE_MAX=500
# OCR_CACHE_TTL_MS=259200000
#
# Invoice scan images → Cloud Storage (then Gemini reads gs://… with Vertex AI; faster / fewer JSON parse failures than huge base64).
# Default bucket name: crown-services-invoices. Service account needs objectCreator on the bucket; Vertex uses same GCP project.
# GCS_INVOICE_IMAGES_BUCKET=crown-services-invoices

# --- Backend backup (optional) ---
# BACKUP_ENABLED=true
# BACKUP_GCS_BUCKET=your-gcs-bucket-name  # or GCS_BUCKET
