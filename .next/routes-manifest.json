{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/inventory/import-fixes/[batchId]",
      "regex": "^/inventory/import\\-fixes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbatchId": "nxtPbatchId"
      },
      "namedRegex": "^/inventory/import\\-fixes/(?<nxtPbatchId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/reset-password/[token]",
      "regex": "^/reset\\-password/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/reset\\-password/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/store/[shop_slug]",
      "regex": "^/store/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPshop_slug": "nxtPshop_slug"
      },
      "namedRegex": "^/store/(?<nxtPshop_slug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/storefront/[shopId]",
      "regex": "^/storefront/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPshopId": "nxtPshopId"
      },
      "namedRegex": "^/storefront/(?<nxtPshopId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
